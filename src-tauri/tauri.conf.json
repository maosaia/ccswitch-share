{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ccswitch-share",
  "version": "0.1.0",
  "identifier": "com.ccswitch.share",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "ccswitch-share",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "url": "http://127.0.0.1:8787"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http: https:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/128x128.png"]
  }
}
